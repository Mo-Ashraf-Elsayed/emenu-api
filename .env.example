APP_NAME="Digital Menu"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:4200
# Optional comma-separated browser origins. Local development allows Angular on port 4200.
# CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=emenu
DB_USERNAME=emenu
DB_PASSWORD=emenu-local-change-me
DB_SSLMODE=prefer

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CACHE_STORE=redis
# Exact IP addresses of the edge and Angular renderer that set X-Emenu-Client-IP.
PUBLIC_MENU_TRUSTED_PROXY_IPS=
QUEUE_CONNECTION=redis

MAIL_MAILER=array
FILESYSTEM_DISK=local
MENU_MEDIA_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_BUCKET_OWNER_ENFORCED=true
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
